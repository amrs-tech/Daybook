# Server-only connection using a dedicated role granted daybook_server membership.
# Never use an existing personal or production database for this demo.
# Percent-encode reserved password characters: # => %23, @ => %40.
# Supabase connections use the bundled public CA with strict TLS verification.
DATABASE_URL=postgresql://daybook_backend:CHANGE_ME@localhost:54329/daybook
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# No assumed model ID: verify availability with npm run preflight.
GEMINI_MODEL_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
# Local-only synthetic fixture replay; rejected in production.
LOCAL_DEMO_ENABLED=false
LOCAL_SESSION_SECRET=
# Only for local replay without a PostgreSQL server. Never allowed in production.
LOCAL_DATABASE_PATH=
# Optional eligible fallback, disabled until both are configured.
OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_FALLBACK_ENABLED=false
DEMO_MODE_ENABLED=true
DEMO_MAX_VOICE_SECONDS=45
DEMO_MAX_AUDIO_BYTES=8388608
